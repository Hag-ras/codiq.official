# Production settings for the Codiq API (Render). Copy the values into the host's environment variables. Never commit real values.
NODE_ENV=production
PORT=4000

# Supabase project "codiq" (ref dteofilfyddowqkfzfzv, region eu-central-1).
# Get the password: Supabase dashboard > Project Settings > Database > Reset database password.
# Pooled connection (for the running API): Project Settings > Database > Connection string > Transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.dteofilfyddowqkfzfzv:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Direct connection (used only by `prisma migrate`): the "Session pooler" string on port 5432 also works when your network has no IPv6.
DIRECT_URL=postgresql://postgres.dteofilfyddowqkfzfzv:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

FRONTEND_URL=https://<your-web-domain>
API_PUBLIC_URL=https://<your-api-domain>

# Generate with: openssl rand -base64 48   (new values for production, different from local)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAIL_FROM=Codiq <hello@your-verified-domain>

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_INSTALLMENT_INTEGRATION_IDS=
FAWRY_BASE_URL=https://www.atfawry.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
INSTAPAY_ADDRESS=

# Videos are on YouTube for now, so storage can stay empty until you upload files (assignment uploads, receipts and avatars DO need it).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=codiq
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Live classes (LiveKit Cloud)
LIVEKIT_URL=
LIVEKIT_HTTP_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
