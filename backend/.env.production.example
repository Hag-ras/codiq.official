# Production settings for the Codiq API (Render). Copy the values into the host's environment variables. Never commit real values.
NODE_ENV=production
PORT=4000

# PostgreSQL, from any provider (Supabase, Aiven, Neon, Render Postgres, your own server). Nothing in the code is provider specific.
# To move to another provider later, follow docs/HOSTING.md ("Moving the database").
#
# DATABASE_URL = what the running API uses. DIRECT_URL = what `prisma migrate` uses. Two rules:
#  - Provider WITH a connection pooler (Supabase): DATABASE_URL = pooled address (add ?pgbouncer=true&connection_limit=5), DIRECT_URL = direct or session-pooler address.
#  - Provider WITHOUT one (Aiven, Render Postgres, Neon direct): put the SAME address in both and do not add pgbouncer.
# Most hosted databases require SSL: end the address with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

FRONTEND_URL=https://<your-web-domain>
API_PUBLIC_URL=https://<your-api-domain>

# Generate with: openssl rand -base64 48   (new values for production, different from local)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Scheduled emails and webhook retries run inside this process. Keep true (and keep the service always on).
JOBS_ENABLED=true

GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAIL_FROM=Codiq <hello@your-verified-domain>

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_INSTALLMENT_INTEGRATION_IDS=
FAWRY_BASE_URL=https://www.atfawry.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
INSTAPAY_ADDRESS=

# Videos are on YouTube for now, so storage can stay empty until you upload files (assignment uploads, receipts and avatars DO need it).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=codiq
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Live classes (LiveKit Cloud)
LIVEKIT_URL=
LIVEKIT_HTTP_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
