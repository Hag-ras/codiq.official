NODE_ENV=development
PORT=4000
# Local Docker Postgres. For Supabase see docs/SETUP-KEYS.md (pooled URL here, direct URL below).
DATABASE_URL=postgresql://codiq:codiq@localhost:5432/codiq
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL=postgresql://codiq:codiq@localhost:5432/codiq
FRONTEND_URL=http://localhost:3000
# Public URL payment providers can reach for webhooks (use ngrok/cloudflared in dev)
API_PUBLIC_URL=http://localhost:4000

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# S3-compatible storage. Local: MinIO (docker compose). Production: Cloudflare R2, see docs/SETUP-KEYS.md
#   R2:  S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=codiq
S3_ACCESS_KEY=codiq
S3_SECRET_KEY=codiq-secret

# Google sign-in: OAuth "Web application" Client ID (also set NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=

# Email via Resend (https://resend.com). Leave RESEND_API_KEY empty in dev: emails are only logged.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend (onboarding@resend.dev only reaches your own account)
MAIL_FROM=Codiq <onboarding@resend.dev>

# LiveKit (dev server from docker-compose uses devkey/secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Paymob (Accept) — cards, mobile wallets, installments (valU etc.)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
# comma-separated for several installment providers
PAYMOB_INSTALLMENT_INTEGRATION_IDS=

# Fawry (Pay at Fawry reference codes)
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=

# InstaPay (manual transfer + admin review)
INSTAPAY_ADDRESS=codiq@instapay
