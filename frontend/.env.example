API_URL=http://localhost:4000
# Must match the backend's JWT_ACCESS_SECRET (middleware verifies the role claim)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars

# Same value as the backend GOOGLE_CLIENT_ID (public, it is safe in the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Live support chat connects straight to the API (WebSocket)
NEXT_PUBLIC_WS_URL=http://localhost:4000
